# Скопируй этот файл в .env и заполни. Файл .env никому не показывай и не коммить.

# 1) Бот — тот самый «один чат». Создай бота у @BotFather командой /newbot и вставь токен.
BOT_TOKEN=

# 2) Доступ к твоему аккаунту (нужен для папок и чтения чатов).
#    https://my.telegram.org → API development tools → создать приложение.
TG_API_ID=
TG_API_HASH=

# 3) Ключ Claude: https://platform.claude.com → API Keys
ANTHROPIC_API_KEY=

# --- Необязательные настройки ---

# Часовой пояс (можно поменять и из чата: «мой часовой пояс — Вильнюс»)
TIMEZONE=Europe/Moscow

# Время утренней сводки, ЧЧ:ММ, или off
DIGEST_TIME=09:00

# Как часто искать задачи в новых сообщениях, в минутах
SCAN_INTERVAL_MIN=10

# Группы: mentions — только где тебя упомянули или ответили тебе (и твои сообщения),
# all — все сообщения во всех группах, off — группы не читать
GROUPS_MODE=mentions

# Чаты, которые никогда не отправляются ИИ: id или @username через запятую
EXCLUDED_CHATS=

# Модель Claude
CLAUDE_MODEL=claude-opus-5-5

# Сколько последних сообщений каждого чата показывать ИИ при раскладке по папкам
FOLDER_CONTEXT_MESSAGES=3

# Сколько чатов (самых свежих) раскладывать по папкам за раз
MAX_CHATS_FOR_SORT=400

# Где хранить сессии и базу
DATA_DIR=data
