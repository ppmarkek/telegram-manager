# Скопируй этот файл в .env и заполни. Файл .env никому не показывай и не коммить.

# 1) Бот — тот самый «один чат». Создай бота у @BotFather командой /newbot и вставь токен.
BOT_TOKEN=

# 2) Доступ к твоему аккаунту (нужен для папок и чтения чатов).
#    https://my.telegram.org → API development tools → создать приложение.
TG_API_ID=
TG_API_HASH=

# 3) Чем думает помощник:
#    agy    — Antigravity CLI (лимиты твоего Google-аккаунта). Установи agy и один раз войди: `agy`.
#    claude — Claude API, нужен ANTHROPIC_API_KEY (оплата за токены).
AI_BACKEND=agy

# --- agy ---

# Модель по умолчанию (id из `agy models`). Пусто — модель по умолчанию в agy.
# Удобнее выбирать в чате кнопкой «🧠 Модель».
AGY_MODEL=

# Путь к agy, если его нет в PATH (обычно ~/.local/bin/agy находится сам)
AGY_BIN=agy

# Пустая папка, в которой запускается agy. По умолчанию ~/.tgmanager/agy-workspace.
# Не указывай папку проекта: агенту agy там нечего делать рядом с .env и сессиями.
AGY_WORKDIR=

# Сколько минут ждать ответа agy
AGY_TIMEOUT_MIN=10

# Запускать agy с --sandbox (ограничение на выполнение команд). Выключай (0), только если agy с ним не работает.
AGY_SANDBOX=1

# Как часто (в часах) обновлять agy и проверять новые модели. 0 — не проверять.
AUTO_UPDATE_HOURS=12

# --- Claude API (только для AI_BACKEND=claude) ---

# Ключ: https://platform.claude.com → API Keys
ANTHROPIC_API_KEY=
# Пусто — claude-opus-5-5
CLAUDE_MODEL=

# --- Необязательные настройки ---

# Часовой пояс (можно поменять и из чата: «мой часовой пояс — Вильнюс»)
TIMEZONE=Europe/Moscow

# Время утренней сводки, ЧЧ:ММ, или off
DIGEST_TIME=09:00

# Как часто искать задачи в новых сообщениях, в минутах
SCAN_INTERVAL_MIN=10

# Группы: mentions — только где тебя упомянули или ответили тебе (и твои сообщения),
# all — все сообщения во всех группах, off — группы не читать
GROUPS_MODE=mentions

# Чаты, которые никогда не отправляются ИИ: id или @username через запятую
EXCLUDED_CHATS=

# Сколько последних сообщений каждого чата показывать ИИ при раскладке по папкам
FOLDER_CONTEXT_MESSAGES=3

# Сколько чатов (самых свежих) раскладывать по папкам за раз
MAX_CHATS_FOR_SORT=400

# Где хранить сессии и базу
DATA_DIR=data
